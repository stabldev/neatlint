{
  "name": "neatlint",
  "version": "1.0.0",
  "description": "CLI tool to automatically set up ESLint and Prettier for a project.",
  "author": "StablDev <thestabldev@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stabldev/neatlint.git"
  },
  "homepage": "https://github.com/stabldev/neatlint#readme",
  "bugs": "https://github.com/stabldev/neatlint/issues",
  "publishConfig": {
    "provenance": true
  },
  "type": "module",
  "main": "./dist/cli.js",
  "bin": {
    "neatlint": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsup src/cli.ts --format esm --clean",
    "prepack": "npm run build"
  },
  "keywords": [
    "eslint",
    "prettier",
    "linter",
    "format",
    "lint",
    "code",
    "style",
    "quality",
    "testing",
    "typescript",
    "javascript"
  ],
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.1.1",
      "onFail": "download"
    }
  },
  "dependencies": {
    "cac": "^7.0.0",
    "execa": "^9.6.1",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^25.7.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
